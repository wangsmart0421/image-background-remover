# 环境变量示例文件
# 复制此文件为 .env 并填写实际值

# ============ Remove.bg API 配置 ============
# 从 https://www.remove.bg/api 获取
REMOVEBG_API_KEY=your_removebg_api_key_here

# ============ Cloudflare 配置 ============
# Cloudflare Account ID (从 Cloudflare Dashboard 获取)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare API Token (需要 workers:edit 权限)
CLOUDFLARE_API_TOKEN=your_api_token_here

# ============ 应用配置 ============
# 最大文件大小（字节），默认10MB
MAX_FILE_SIZE=10485760

# 允许的源（CORS），用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.pages.dev

# ============ 部署配置 ============
# 前端部署域名（Cloudflare Pages）
FRONTEND_DOMAIN=your-app.pages.dev

# Worker 部署域名
WORKER_DOMAIN=api.your-domain.com

# ============ 开发配置 ============
# 本地开发端口
FRONTEND_PORT=3000
WORKER_PORT=8787

# ============ 可选配置 ============
# 启用调试模式
DEBUG=false

# 请求超时时间（毫秒）
REQUEST_TIMEOUT=30000

# 启用请求日志
LOG_REQUESTS=true