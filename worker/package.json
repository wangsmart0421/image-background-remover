{
  "name": "bg-remover-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for Remove.bg API proxy",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.js --bundle --outfile=dist/index.js --format=esm --target=es2022",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.js",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "itty-router": "^4.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231121.0",
    "esbuild": "^0.19.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4",
    "wrangler": "^3.18.0"
  }
}
