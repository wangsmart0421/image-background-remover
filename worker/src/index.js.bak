import { Router } from 'itty-router'

// 创建路由器
const router = Router()

// ==================== 配置 ====================
const PLANS = {
  free: { name: 'Free', credits: 0, daily: 1, monthly: 0, maxFileSize: 2 * 1024 * 1024 },
  starter: { name: 'Starter', credits: 30, daily: 0, monthly: 30, maxFileSize: 5 * 1024 * 1024 },
  pro: { name: 'Pro', credits: 50, daily: 0, monthly: 50, maxFileSize: 10 * 1024 * 1024 },
  ultimate: { name: 'Ultimate', credits: 100, daily: 0, monthly: 100, maxFileSize: 25 * 1024 * 1024 }
}

const PAYPAL_CONFIG = {
  clientId: 'your_paypal_client_id',
  clientSecret: 'your_paypal_secret',
  mode: 'sandbox', // 生产环境改为 'live'
  returnUrl: 'https://your-domain.com/payment/success',
  cancelUrl: 'https://your-domain.com/payment/cancel'
}

// ==================== 工具函数 ====================
function createToken(payload) {
  // 简化的 token 生成（生产环境应使用 JWT）
  const data = btoa(JSON.stringify(payload))
  const timestamp = Date.now()
  return `${data}.${timestamp}`
}

function verifyToken(token) {
  try {
    const [data] = token.split('.')
    return JSON.parse(atob(data))
  } catch {
    return null
  }
}

async function getUserFromKV(userId) {
  try {
    const key = `user:${userId}`
    const data = await USER_KV.get(key, 'json')
    return data
  } catch {
    return null
  }
}

async function saveUserToKV(userId, userData) {
  const key = `user:${userId}`
  await USER_KV.put(key, JSON.stringify(userData))
}

async function getDailyUsage(userId) {
  try {
    const today = new Date().toISOString().split('T')[0]
    const key = `usage:${userId}:${today}`
    const data = await USER_KV.get(key, 'json')
    return data || { date: today, count: 0 }
  } catch {
    return { date: new Date().toISOString().split('T')[0], count: 0 }
  }
}

async function incrementDailyUsage(userId) {
  const today = new Date().toISOString().split('T')[0]
  const key = `usage:${userId}:${today}`
  let usage = await getDailyUsage(userId)
  
  if (usage.date !== today) {
    usage = { date: today, count: 0 }
  }
  usage.count++
  
  await USER_KV.put(key, JSON.stringify(usage))
  return usage
}

// 检查并更新月度配额
async function checkAndResetMonthlyQuota(user) {
  const now = new Date()
  const lastReset = user.lastQuotaReset ? new Date(user.lastQuotaReset) : null
  
  if (!lastReset || now.getMonth() !== lastReset.getMonth() || now.getFullYear() !== lastReset.getFullYear()) {
    //新月，重置配额
    const plan = PLANS[user.plan] || PLANS.free
    user.credits = plan.monthly
    user.lastQuotaReset = now.toISOString()
    await saveUserToKV(user.id, user)
  }
}

// ==================== 认证中间件 ====================
async function authenticate(request) {
  const authHeader = request.headers.get('Authorization')
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return null
  }
  
  const token = authHeader.slice(7)
  const payload = verifyToken(token)
  
  if (!payload || !payload.userId) {
    return null
  }
  
  const user = await getUserFromKV(payload.userId)
  return user
}

// ==================== CORS ====================
const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
  'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  'Access-Control-Max-Age': '86400',
}

function addCorsHeaders(response) {
  const headers = new Headers(response.headers)
  Object.entries(corsHeaders).forEach(([key, value]) => {
    headers.set(key, value)
  })
  return new Response(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers,
  })
}

router.options('*', () => {
  return new Response(null, { status: 204, headers: corsHeaders })
})

// ==================== 公开端点 ====================
router.get('/health', () => {
  return new Response(JSON.stringify({ status: 'ok', timestamp: new Date().toISOString() }), {
    headers: { 'Content-Type': 'application/json' },
  })
})

router.get('/info', () => {
  return new Response(JSON.stringify({
    service: 'Background Remover API',
    version: '2.0.0',
    provider: 'Remove.bg',
    limits: { maxFileSize: parseInt(MAX_FILE_SIZE || '10485760') }
  }), { headers: { 'Content-Type': 'application/json' } })
})

// 获取套餐信息
router.get('/api/plans', () => {
  return new Response(JSON.stringify({ plans: PLANS }), {
    headers: { 'Content-Type': 'application/json' }
  })
})

// 创建支付订单
router.post('/api/payment/create', async (request) => {
  try {
    const user = await authenticate(request)
    if (!user) {
      return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401, headers: { 'Content-Type': 'application/json' } })
    }
    
    const body = await request.json()
    const { planId } = body
    
    if (!PLANS[planId]) {
      return new Response(JSON.stringify({ error: 'Invalid plan' }), { status: 400, headers: { 'Content-Type': 'application/json' } })
    }
    
    const plan = PLANS[planId]
    
    // 创建 PayPal 订单（简化版，实际需要调用 PayPal API）
    const orderId = `order_${Date.now()}_${user.id}`
    
    // 保存订单信息
    const orderKey = `order:${orderId}`
    const orderData = {
      id: orderId,
      userId: user.id,
      planId,
      credits: plan.credits,
      amount: getPlanPrice(planId),
      status: 'pending',
      createdAt: new Date().toISOString()
    }
    
    try {
      await USER_KV.put(orderKey, JSON.stringify(orderData))
    } catch (e) {
      console.log('KV not available, skipping order save')
    }
    
    return new Response(JSON.stringify({
      orderId,
      amount: orderData.amount,
      currency: 'USD',
      status: 'pending'
    }), { headers: { 'Content-Type': 'application/json' } })
    
  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } })
  }
})

function getPlanPrice(planId) {
  const prices = { starter: 4.99, pro: 9.99, ultimate: 19.99 }
  return prices[planId] || 0
}

// PayPal 支付回调
router.post('/api/payment/webhook', async (request) => {
  try {
    const body = await request.json()
    
    // 验证 PayPal 回调（生产环境需要验证签名）
    const { orderId, status, userId } = body
    
    if (status === 'COMPLETED') {
      // 获取订单信息
      let orderData = null
      try {
        orderData = JSON.parse(await USER_KV.get(`order:${orderId}`, 'json'))
      } catch (e) {}
      
      if (orderData && orderData.status === 'pending') {
        // 更新订单状态
        orderData.status = 'completed'
        try {
          await USER_KV.put(`order:${orderId}`, JSON.stringify(orderData))
        } catch (e) {}
        
        // 发放配额
        const user = await getUserFromKV(orderData.userId)
        if (user) {
          user.credits = (user.credits || 0) + orderData.credits
          user.plan = orderData.planId
          await saveUserToKV(user.id, user)
        }
      }
    }
    
    return new Response(JSON.stringify({ received: true }), { headers: { 'Content-Type': 'application/json' } })
  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } })
  }
})

// 用户注册/登录（简化版 - 实际应使用 OAuth）
router.post('/api/auth/register', async (request) => {
  try {
    const body = await request.json()
    const { email, name, picture } = body
    
    // 生成用户 ID
    const userId = `user_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`
    
    // 创建用户数据
    const user = {
      id: userId,
      email: email || '',
      name: name || 'User',
      picture: picture || '',
      plan: 'free',
      credits: 10, // 注册赠送 10 次
      totalUsed: 0,
      createdAt: new Date().toISOString(),
      lastQuotaReset: new Date().toISOString()
    }
    
    await saveUserToKV(userId, user)
    
    // 生成 token
    const token = createToken({ userId })
    
    return new Response(JSON.stringify({
      success: true,
      token,
      user: { id: user.id, name: user.name, email: user.email, picture: user.picture }
    }), { headers: { 'Content-Type': 'application/json' } })
    
  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } })
  }
})

// 获取用户信息
router.get('/api/user', async (request) => {
  const user = await authenticate(request)
  if (!user) {
    return new Response(JSON.stringify({ authenticated: false }), { headers: { 'Content-Type': 'application/json' } })
  }
  
  return new Response(JSON.stringify({
    authenticated: true,
    user: {
      id: user.id,
      name: user.name,
      email: user.email,
      picture: user.picture,
      plan: user.plan,
      credits: user.credits || 0,
      totalUsed: user.totalUsed || 0
    }
  }), { headers: { 'Content-Type': 'application/json' } })
})

// 获取用户配额
router.get('/api/quota', async (request) => {
  const user = await authenticate(request)
  if (!user) {
    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401, headers: { 'Content-Type': 'application/json' } })
  }
  
  // 检查是否需要重置月度配额
  await checkAndResetMonthlyQuota(user)
  
  // 获取今日使用
  const dailyUsage = await getDailyUsage(user.id)
  const plan = PLANS[user.plan] || PLANS.free
  
  return new Response(JSON.stringify({
    used: dailyUsage.count,
    limit: plan.daily || 999999, // 订阅用户无每日限制
    credits: user.credits || 0,
    plan: user.plan || 'free',
    resetDate: getNextResetDate()
  }), { headers: { 'Content-Type': 'application/json' } })
})

function getNextResetDate() {
  const now = new Date()
  const nextMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1)
  return nextMonth.toISOString()
}

// 获取用户订单
router.get('/api/orders', async (request) => {
  const user = await authenticate(request)
  if (!user) {
    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401, headers: { 'Content-Type': 'application/json' } })
  }
  
  // 简化：返回空订单列表（实际需要遍历订单）
  return new Response(JSON.stringify([]), { headers: { 'Content-Type': 'application/json' } })
})

// ==================== 核心API：背景去除 ====================
router.post('/api/remove-bg', async (request) => {
  // 认证检查
  const user = await authenticate(request)
  if (!user) {
    return new Response(JSON.stringify({ error: 'Unauthorized. Please login first.' }), { 
      status: 401, 
      headers: { 'Content-Type': 'application/json' } 
    })
  }
  
  // 检查配额
  const plan = PLANS[user.plan] || PLANS.free
  const dailyUsage = await getDailyUsage(user.id)
  
  // 检查免费用户每日限制
  if (user.plan === 'free' && dailyUsage.count >= plan.daily) {
    return new Response(JSON.stringify({ 
      error: 'Daily limit reached. Please upgrade your plan or come back tomorrow.' 
    }), { status: 403, headers: { 'Content-Type': 'application/json' } })
  }
  
  // 检查订阅用户配额
  if (user.plan !== 'free' && (!user.credits || user.credits <= 0)) {
    return new Response(JSON.stringify({ 
      error: 'Insufficient credits. Please purchase more credits.' 
    }), { status: 403, headers: { 'Content-Type': 'application/json' } })
  }
  
  try {
    // 验证 API 密钥
    if (!REMOVEBG_API_KEY) {
      return new Response(JSON.stringify({ error: 'Remove.bg API key not configured' }), { 
        status: 500, 
        headers: { 'Content-Type': 'application/json' } 
      })
    }
    
    // 解析请求体
    let body
    try {
      body = await request.json()
    } catch {
      return new Response(JSON.stringify({ error: 'Invalid JSON body' }), { 
        status: 400, 
        headers: { 'Content-Type': 'application/json' } 
      })
    }
    
    const { image, size = 'auto', format = 'png', crop = false } = body
    
    if (!image) {
      return new Response(JSON.stringify({ error: 'Image data is required' }), { 
        status: 400, 
        headers: { 'Content-Type': 'application/json' } 
      })
    }
    
    // 验证文件大小
    const maxSize = plan.maxFileSize
    if (image.startsWith('data:image/')) {
      const base64Data = image.split(',')[1]
      if (base64Data) {
        const fileSize = Math.ceil(base64Data.length * 0.75)
        if (fileSize > maxSize) {
          return new Response(JSON.stringify({ 
            error: `File too large. Maximum size is ${maxSize / 1024 / 1024}MB for your plan` 
          }), { status: 413, headers: { 'Content-Type': 'application/json' } })
        }
      }
    }
    
    // 提取 Base64
    const base64Data = image.includes(',') ? image.split(',')[1] : image
    
    // 调用 Remove.bg API
    const formData = new FormData()
    formData.append('image_file_b64', base64Data)
    formData.append('size', size)
    formData.append('format', format)
    if (crop) formData.append('crop', 'true')
    
    const removeBgResponse = await fetch('https://api.remove.bg/v1.0/removebg', {
      method: 'POST',
      headers: { 'X-Api-Key': REMOVEBG_API_KEY },
      body: formData,
    })
    
    if (!removeBgResponse.ok) {
      const errorText = await removeBgResponse.text()
      return new Response(JSON.stringify({ 
        error: 'Failed to remove background',
        details: errorText
      }), { status: removeBgResponse.status, headers: { 'Content-Type': 'application/json' } })
    }
    
    // 更新配额使用
    if (user.plan !== 'free') {
      user.credits = (user.credits || 1) - 1
      user.totalUsed = (user.totalUsed || 0) + 1
      await saveUserToKV(user.id, user)
    } else {
      await incrementDailyUsage(user.id)
      user.totalUsed = (user.totalUsed || 0) + 1
      await saveUserToKV(user.id, user)
    }
    
    // 返回结果
    const resultBlob = await removeBgResponse.blob()
    const resultBuffer = await resultBlob.arrayBuffer()
    const resultBase64 = btoa(
      new Uint8Array(resultBuffer).reduce((data, byte) => data + String.fromCharCode(byte), '')
    )
    
    return new Response(JSON.stringify({
      success: true,
      image: `data:image/${format};base64,${resultBase64}`,
      format: format,
      size: resultBuffer.byteLength,
      remainingCredits: user.plan === 'free' ? (plan.daily - dailyUsage.count - 1) : (user.credits || 0)
    }), { headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } })
    
  } catch (error) {
    return new Response(JSON.stringify({ error: 'Internal server error', message: error.message }), { 
      status: 500, 
      headers: { 'Content-Type': 'application/json' } 
    })
  }
})

// ==================== 404 ====================
router.all('*', () => {
  return new Response(JSON.stringify({ 
    error: 'Not found',
    endpoints: [
      'GET /health',
      'GET /info',
      'GET /api/plans',
      'POST /api/auth/register',
      'GET /api/user',
      'GET /api/quota',
      'GET /api/orders',
      'POST /api/payment/create',
      'POST /api/payment/webhook',
      'POST /api/remove-bg'
    ]
  }), { status: 404, headers: { 'Content-Type': 'application/json' } })
})

// ==================== 定时任务：重置每日配额 ====================
async function resetDailyQuota() {
  try {
    // 获取所有用户（简化：需要单独维护用户列表或扫描）
    // 这里可以添加更多逻辑
    console.log('Daily quota reset triggered at', new Date().toISOString())
  } catch (error) {
    console.error('Reset error:', error)
  }
}

// ==================== Worker 入口 ====================
export default {
  async fetch(request, env, ctx) {
    globalThis.REMOVEBG_API_KEY = env.REMOVEBG_API_KEY
    globalThis.MAX_FILE_SIZE = env.MAX_FILE_SIZE
    globalThis.ALLOWED_ORIGINS = env.ALLOWED_ORIGINS
    globalThis.USER_KV = env.USER_KV
    
    const response = await router.handle(request)
    return addCorsHeaders(response)
  },
  
  // 定时触发器
  async scheduled(event, env, ctx) {
    globalThis.USER_KV = env.USER_KV
    await resetDailyQuota()
  }
}
